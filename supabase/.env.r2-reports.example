# Cloudflare R2 secrets for WhatsApp report PDFs (Supabase Edge — PHPL)
# Never commit real values. Set with:
#   npx supabase secrets set --project-ref gqpqnfvihjjkmbcdzate `
#     R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... `
#     R2_BUCKET_NAME=lims-wa-reports R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lims-wa-reports
# Public URL base (r2.dev public bucket URL or custom domain). No trailing slash.
R2_PUBLIC_BASE_URL=

# Bucket CORS (Cloudflare dashboard → R2 → bucket → Settings → CORS):
# [
#   {
#     "AllowedOrigins": ["https://lims.phpathlabs.com", "http://localhost:8080", "http://127.0.0.1:8080"],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# Also enable "Public access" (r2.dev subdomain) or attach a custom domain.