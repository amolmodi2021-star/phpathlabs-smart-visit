# Durable Supabase CLI auth for PHPL (never commit the real .env.cli-auth)
# Copy to supabase/.env.cli-auth and fill both values.
#
# 1) SUPABASE_ACCESS_TOKEN — Account Access Tokens (sbp_…), long custom expiry
#    https://supabase.com/dashboard/account/tokens
# 2) SUPABASE_DB_PASSWORD — Project Settings → Database (or reset if forgotten)
#    Required for `supabase link` / `db push` (Postgres), separate from the access token.
#
# Then:  powershell -File scripts/supabase-db-push.ps1

SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
CLOUD_PROJECT_REF=gqpqnfvihjjkmbcdzate
