{
  "name": "phpathlabs-tally-bridge",
  "version": "1.2.0",
  "private": true,
  "description": "PH PathLabs TallyPrime bridge (Electron, button push, no polling)",
  "main": "electron-main.cjs",
  "author": "PH PathLabs",
  "scripts": {
    "start": "node index.cjs",
    "start:electron": "electron .",
    "build:exe": "pkg . --targets node24-win-x64 --output dist/PHPathLabs-TallyBridge-node.exe --compress GZip",
    "build:electron": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.phpathlabs.tallybridge",
    "productName": "PH PathLabs Tally Bridge",
    "copyright": "Copyright PH PathLabs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.cjs",
      "index.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PHPathLabs-TallyBridge.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
